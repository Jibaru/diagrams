  "clusters": {
    "aws_vpc": { "label": "VPC <name>" },
    "aws_subnet": { "label": "public subnet / private subnet", "note": "only when subnets separate things the reader cares about (ALB public, services private); otherwise skip" },
    "aws_ecs_cluster": { "label": "ECS <name>" },
    "kubernetes_namespace": { "label": "ns <name>" },
    "module": { "label": "<module name>", "note": "each `module \"x\"` block is a cluster; nested modules nest" }
  },
  "edges": {
    "aws_lambda_event_source_mapping": "event_source_arn -> function_name (label 'poll')",
    "aws_sns_topic_subscription": "topic_arn -> endpoint (label protocol)",
    "aws_s3_bucket_notification": "bucket -> lambda/queue/topic (label events)",
    "aws_cloudwatch_event_target": "rule -> arn target",
    "aws_lb_listener + aws_lb_target_group + aws_lb_target_group_attachment": "lb -> target (label port)",
    "aws_route53_record (alias)": "zone -> alias target",
    "aws_api_gateway_integration / aws_apigatewayv2_integration": "api -> integration_uri target (label route)",
    "aws_lambda_permission": "principal service -> function when no other resource expresses it",
    "aws_cloudfront_distribution origin": "distribution -> each origin (S3, ALB, API Gateway, Lambda URL)",
    "attribute reference": "any `<type>.<name>.<attr>` inside another resource's arguments is a candidate edge from the referencing resource to the referenced one; keep it when it carries traffic or data (invoke, read/write, publish, subscribe), drop it when it only wires IAM, logging, tags or networking plumbing",
    "depends_on": "edge only when no attribute reference already exists and the dependency is a runtime one"
  },
  "hidden": [
