    "aws_cloudfront_distribution": { "node": "aws/network/CloudFront" },
    "aws_route53_zone": { "node": "aws/network/Route53", "note": "fold records into the zone; edge from zone to each alias target" },
    "aws_nat_gateway": { "node": "aws/network/NATGateway" },
